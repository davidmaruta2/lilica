# Public client configuration used by the Phase 5 mobile authentication client.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public, app-specific RevenueCat SDK keys. These are intentionally public
# mobile configuration values, not RevenueCat secret API keys.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your-revenuecat-apple-public-sdk-key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your-revenuecat-google-public-sdk-key

# Never place access tokens, database passwords, secret/service-role keys, or
# other privileged credentials in an EXPO_PUBLIC_* variable or this file.
