{
  "expo": {
    "name": "Lilica",
    "slug": "lilica",
    "scheme": "lilica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/lilica-app-icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/13d12e42-4800-440f-9f38-9c93f5403c6f"
    },
    "ios": {
      "bundleIdentifier": "com.luxfordinteractive.lilica",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:lilica.co.uk"
      ]
    },
    "android": {
      "package": "com.luxfordinteractive.lilica",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#062B33",
        "foregroundImage": "./assets/lilica-app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "lilica.co.uk",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/lilica-app-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Lilica to use your camera to scan important documents.",
          "photosPermission": "Allow Lilica to access documents saved in your photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#63364D"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "13d12e42-4800-440f-9f38-9c93f5403c6f"
      }
    },
    "owner": "davidmaruta2"
  }
}
