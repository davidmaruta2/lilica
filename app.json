{
  "expo": {
    "name": "Lilica",
    "slug": "lilica",
    "scheme": "lilica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.luxfordinteractive.lilica",
      "supportsTablet": false,
      "associatedDomains": ["applinks:lilica.co.uk"]
    },
    "android": {
      "package": "com.luxfordinteractive.lilica",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "lilica.co.uk", "pathPrefix": "/invite" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Lilica to use your camera to scan important documents.",
          "photosPermission": "Allow Lilica to access documents saved in your photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#63364D"
        }
      ],
      "expo-sharing"
    ]
  }
}
